[Misspent Mobile Filter 1.0]
! Title: 🔍 Misspent: Reformed - Mobile
! Description: A list that removes/changes the not needed elements from websites.
! Homepage: https://github.com/misspent/Random-Stuff

! 🌐 EVERYTHING Square (Global)
*##*:style(border-radius: 0px !important; text-shadow: none !important; box-shadow: none !important;)


! Brave Search Engine - Cleaner
search.brave.com####faq.snippet
search.brave.com###main > footer
search.brave.com###related-queries
search.brave.com###search-elsewhere
search.brave.com##.snippet .generic-snippet
search.brave.com##.snippet[data-type="cluster"]
search.brave.com##*:style(border-radius: !important; text-shadow: none !important; box-shadow: none !important;)

! DuckDuckGo Cleaner
duckduckgo.com##li[data-layout="related_searches"]
duckduckgo.com##article[data-testid="result"] > div:has([data-result="snippet"] span b)
duckduckgo.com##*:style(border-radius: !important; text-shadow: none !important; box-shadow: none !important;)

! APKMirror - Less scrolling
apkmirror.com##.tab-content > .tab-pane:has(.notes.wrapText)
apkmirror.com##.container-fluid > #sidebar[role="complementary"]
apkmirror.com##article > .listWidget:has(.appRow .table-cell):not(.p-relative)
apkmirror.com##.card-with-tabs > .tab-buttons.d-flex:has([data-action="frontend_ajax_generate_qr"])
apkmirror.com##*:style(border-radius: !important; text-shadow: none !important; box-shadow: none !important;)

! IMDb cleaner
imdb.com##.ipc-title__actions
imdb.com##footer.imdb-footer.footer
imdb.com##.ipc-poster-card .ipc-poster-card__actions
imdb.com##[data-testid="title-details-companycredits"]
imdb.com##section.ipc-page-background.ipc-page-background--baseAlt:has(.recently-viewed)
imdb.com##section.ipc-page-section.ipc-page-section--none.ipc-page-section--tp-none.ipc-page-section--bp-none:has(iframe[title="Episode Ratings Spotlight"])
imdb.com##.ipc-page-grid__item > section:is([data-cel-widget="StaticFeature_RelatedInterests"], [data-cel-widget="StaticFeature_FAQ"], [data-cel-widget="StaticFeature_News"], [data-cel-widget="StaticFeature_Contribution"], [data-testid="more-from-section"], [cel_widget_id="StaticFeature_Videos"], section.ipc-page-section:has([data-testid="main-column-editorial-single"]))
imdb.com##*:style(border-radius: !important; text-shadow: none !important; box-shadow: none !important;)
